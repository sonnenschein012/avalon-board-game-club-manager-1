rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.email is string;
    }

    // This account can restore the first master document if the admins
    // collection is ever empty or accidentally changed.
    function isBootstrapMaster() {
      return hasEmail() && request.auth.token.email == 'eunchangyang1@gmail.com';
    }

    // 1. isAdmin() is true only when logged in and the admin document exists
    function isAdmin() {
      return hasEmail() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // 2. isMasterAdmin() checks the role field in admins collection
    function isMasterAdmin() {
      return isBootstrapMaster() ||
        (isAdmin() &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'master');
    }

    // Registered operators share normal interview operations. Master remains
    // reserved for high-risk administration elsewhere in these rules.
    function canManageInterviews() {
      return isAdmin() || isMasterAdmin();
    }

    function publicRoundExists(roundId) {
      return exists(/databases/$(database)/documents/interviewPublicRounds/$(roundId));
    }

    function publicScheduleExists(scheduleId) {
      return scheduleId is string &&
        exists(/databases/$(database)/documents/interviewPublicSchedules/$(scheduleId));
    }

    function accessScheduleId(access) {
      return ('scheduleId' in access && access.scheduleId is string) ? access.scheduleId : null;
    }

    function isLegacySurveyWindowOpen(roundId) {
      let round = get(/databases/$(database)/documents/interviewPublicRounds/$(roundId));
      return publicRoundExists(roundId) &&
        round.data.active == true &&
        round.data.surveyOpensAt is timestamp &&
        round.data.surveyClosesAt is timestamp &&
        request.time >= round.data.surveyOpensAt &&
        request.time < round.data.surveyClosesAt;
    }

    function isScheduleSurveyWindowOpen(scheduleId) {
      let schedule = get(/databases/$(database)/documents/interviewPublicSchedules/$(scheduleId));
      return publicScheduleExists(scheduleId) &&
        schedule.data.active == true &&
        schedule.data.surveyOpensAt is timestamp &&
        schedule.data.surveyClosesAt is timestamp &&
        request.time >= schedule.data.surveyOpensAt &&
        request.time < schedule.data.surveyClosesAt;
    }

    function isSurveyWindowOpen(roundId, scheduleId) {
      return (scheduleId is string && isScheduleSurveyWindowOpen(scheduleId)) ||
        (scheduleId == null && isLegacySurveyWindowOpen(roundId));
    }

    function hasLegacyAvailability(roundId, availability) {
      let round = get(/databases/$(database)/documents/interviewPublicRounds/$(roundId));
      return publicRoundExists(roundId) &&
        round.data.allowedSlots is list &&
        availability.toSet().hasOnly(round.data.allowedSlots);
    }

    function hasScheduleAvailability(scheduleId, availability) {
      let schedule = get(/databases/$(database)/documents/interviewPublicSchedules/$(scheduleId));
      return publicScheduleExists(scheduleId) &&
        schedule.data.allowedSlots is list &&
        availability.toSet().hasOnly(schedule.data.allowedSlots);
    }

    function hasValidAvailability(roundId, scheduleId) {
      let availability = request.resource.data.availability;
      return availability is list &&
        resource.data.firstAccessedAt is timestamp &&
        availability.size() == availability.toSet().size() &&
        ((scheduleId is string && hasScheduleAvailability(scheduleId, availability)) ||
          (scheduleId == null && hasLegacyAvailability(roundId, availability)));
    }

    // Spark 요금제 호환 정책: 최초 접속 시각은 Firestore 서버 시각으로
    // 한 번만 기록한다. 날짜별 4일 범위 계산은 공개 페이지에서 이 값을
    // 기준으로 수행한다. Firestore Rules만으로는 KST 달력 계산·동적 슬롯
    // 목록 생성을 검증할 수 없으므로, 직접 API 요청의 범위까지는 강제하지
    // 않고 회차 전체의 허용 슬롯만 검증한다.
    function isValidPublicFirstAccessUpdate() {
      return resource.data.active == true &&
        resource.data.firstAccessedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstAccessedAt']) &&
        request.resource.data.firstAccessedAt is timestamp &&
        request.resource.data.firstAccessedAt == request.time &&
        isSurveyWindowOpen(resource.data.roundId, accessScheduleId(resource.data));
    }

    function hasValidSubmissionTimestamps() {
      return request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAt == request.time &&
        (
          (resource.data.submittedAt == null &&
            request.resource.data.submittedAt is timestamp &&
            request.resource.data.submittedAt == request.time) ||
          (resource.data.submittedAt is timestamp &&
            request.resource.data.submittedAt == resource.data.submittedAt)
        );
    }

    function isValidPublicResponseUpdate() {
      return resource.data.active == true &&
        (!('assignmentSummary' in resource.data) || resource.data.assignmentSummary == null || resource.data.assignmentSummary.status != 'completed') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['availability', 'submittedAt', 'updatedAt', 'responseUpdatedAt']) &&
        isSurveyWindowOpen(resource.data.roundId, accessScheduleId(resource.data)) &&
        hasValidAvailability(resource.data.roundId, accessScheduleId(resource.data)) &&
        request.resource.data.responseUpdatedAt is timestamp &&
        request.resource.data.responseUpdatedAt == request.time &&
        hasValidSubmissionTimestamps();
    }

    // Internal club operations are available only to registered operators.
    match /members/{memberId} {
      allow read: if isAdmin() || isMasterAdmin();
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /games/{gameId} {
      allow read: if isAdmin() || isMasterAdmin();
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() || isMasterAdmin();
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /attendees/{attendeeId} {
      allow read: if isAdmin() || isMasterAdmin();
      allow create: if (isAdmin() || isMasterAdmin()) &&
                    request.resource.data.keys().hasAll(['name', 'importDate', 'status']) &&
                    request.resource.data.name is string &&
                    request.resource.data.status in ['대기', '편성됨', '결석'];
      allow update: if (isAdmin() || isMasterAdmin()) &&
                    request.resource.data.keys().hasAll(['name', 'importDate', 'status']) &&
                    request.resource.data.name is string &&
                    request.resource.data.status in ['대기', '편성됨', '결석'];
      allow delete: if isAdmin() || isMasterAdmin();
    }

    // 3. DailyPlannings: schema validation
    match /DailyPlannings/{planningId} {
      allow read: if isAdmin() || isMasterAdmin();
      allow create: if (isAdmin() || isMasterAdmin()) && 
                    request.resource.data.keys().hasAll(['date', 'groups', 'createdAt']) &&
                    request.resource.data.date is string &&
                    request.resource.data.groups is list &&
                    request.resource.data.createdAt is timestamp &&
                    request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || isMasterAdmin()) && 
                    request.resource.data.keys().hasAll(['date', 'groups', 'createdAt']) &&
                    request.resource.data.date is string &&
                    request.resource.data.groups is list &&
                    request.resource.data.createdAt is timestamp &&
                    (request.resource.data.createdAt == request.time || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin() || isMasterAdmin();
    }

    // 5. Admins can verify their own role document. Only a master can list or
    // change administrators. The bootstrap master remains usable without a doc.
    match /admins/{adminEmail} {
      allow get: if isMasterAdmin() ||
        (hasEmail() && request.auth.token.email == adminEmail);
      allow list: if isMasterAdmin();
      allow create, update, delete: if isMasterAdmin();
    }

    // Interview configuration and applicant personal data are always private.
    match /interviewRounds/{roundId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewSchedules/{scheduleId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewApplicants/{applicantId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewAssignmentLocks/{lockId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewApplicantKeys/{keyId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewerProfiles/{profileId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewRoundInterviewers/{participantId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewScheduleInterviewers/{participantId} {
      allow read, write: if canManageInterviews();
    }

    match /interviewAssignmentEvents/{eventId} {
      allow read, create: if canManageInterviews();
    }

    // Interview notes can contain sensitive application answers and internal
    // observations, so they are never exposed through an applicant token.
    match /interviewNotes/{noteId} {
      allow read, write: if canManageInterviews();
    }

    // Immutable-style snapshots keep completed and reset/withdrawn interview
    // attempts extractable for V4 without exposing them to applicant links.
    match /interviewRecordEvents/{eventId} {
      allow read, create: if canManageInterviews();
    }

    match /interviewChangeRequests/{token} {
      allow read, write: if canManageInterviews();
    }

    // A public round can be fetched only by its exact document path while it is
    // active. Collection enumeration and all writes remain admin-only.
    match /interviewPublicRounds/{roundId} {
      allow get: if canManageInterviews() || resource.data.active == true;
      allow list: if canManageInterviews();
      allow create, update, delete: if canManageInterviews();
    }

    match /interviewPublicSchedules/{scheduleId} {
      allow get: if canManageInterviews() || resource.data.active == true;
      allow list: if canManageInterviews();
      allow create, update, delete: if canManageInterviews();
    }

    // The token is a bearer credential. Public clients may fetch that exact,
    // active token document and only update their response fields. They cannot
    // enumerate tokens, create/delete documents, or change identity/admin data.
    match /interviewAccess/{token} {
      // Missing exact paths may be read so the UI can show "invalid link";
      // inactive real tokens remain unreadable and token listing stays denied.
      allow get: if canManageInterviews() ||
        !exists(/databases/$(database)/documents/interviewAccess/$(token)) ||
        resource.data.active == true;
      allow list: if canManageInterviews();
      allow create, delete: if canManageInterviews();
      allow update: if canManageInterviews() || isValidPublicResponseUpdate() || isValidPublicFirstAccessUpdate();
    }

    // 6. Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
