{
  "name": "avalon-club-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:staging": "vite --mode staging --port=3000 --host=0.0.0.0",
    "dev:demo": "vite --mode demo --port=3000 --host=127.0.0.1",
    "design-lab": "node scripts/run-demo.mjs",
    "design-lab:test": "playwright test",
    "scenario-lab": "vite --mode scenario --port=5174 --host=127.0.0.1",
    "scenario-lab:test": "playwright test --config playwright.scenario.config.ts",
    "demo": "node scripts/run-demo.mjs",
    "demo:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-demo-java.ps1",
    "demo:serve": "npm run demo:seed && npm run dev:demo",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "build": "vite build && npm run verify:production-bundle",
    "build:staging": "vite build --mode staging && npm run verify:production-bundle",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs",
    "deploy:staging": "npm run build:staging && npm run deploy:staging:rules && npm run deploy:staging:hosting",
    "deploy:staging:rules": "firebase deploy --project avalon-manager-staging --config firebase.staging.json --only firestore --non-interactive",
    "deploy:staging:hosting": "firebase deploy --project avalon-manager-staging --config firebase.staging.json --only hosting --non-interactive",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src tests scripts/*.mjs vite.config.ts playwright.config.ts playwright.scenario.config.ts firestore.rules",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude src/tests/firestore.rules.test.ts",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "15.28.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
